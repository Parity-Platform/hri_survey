              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Very strong"
              },
              "published": true
            },
            {
              "key": "impact_safety",
              "question": "Worker Safety:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Very strong"
              },
              "published": true
            },
            {
              "key": "impact_quality",
              "question": "Product Quality:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Very strong"
              },
              "published": true
            },
            {
              "key": "impact_satisfaction",
              "question": "Worker Satisfaction:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Very strong"
              },
              "published": true
            },
            {
              "key": "impact_cost",
              "question": "Cost Reduction:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Very strong"
              },
              "published": true
            }
          ]
        },
        {
          "title": "4. Final Evaluation",
          "fields": [
            {
              "key": "team_adaptation_rating",
              "question": "How would you rate your team's overall adaptation to working alongside robots?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Poor",
                "2": "Poor",
                "3": "Neutral",
                "4": "Strong",
                "5": "Excellent"
              },
              "published": true
            },
            {
              "key": "supervisor_responsibility_changes",
              "question": "How has robot integration changed your responsibilities as a supervisor?",
              "type": "multi_choice",
              "required": false,
              "options": [
                "More time spent on coordinating workflows",
                "Increased need for technical oversight",
                "Reduced involvement in repetitive tasks",
                "More time spent on employee support and training",
                "No significant change"
              ],
              "published": true
            },
            {
              "key": "critical_support_needed",
              "question": "What type of support would be most critical for ensuring a smooth and successful further integration of robots in your department?",
              "type": "multi_choice",
              "required": false,
              "options": [
                "Additional staff training",
                "Technical support from robot suppliers",
                "More detailed performance data and analytics",
                "Financial resources for upgrades and maintenance",
                "Clearer cross-department coordination",
                "Other"
              ],
              "published": true
            },
            {
              "key": "integration_improvements",
              "question": "What aspect of the integration process would you improve if the transition were repeated?",
              "type": "multi_choice",
              "required": false,
              "options": [
                "Improve training and upskilling of employees",
                "Increase the testing and calibration period before full deployment",
                "Ensure faster or more reliable technical support during early stages",
                "Better planning of workflow redesign around robots",
                "No major improvements needed, the transition was smooth",
                "Other"
              ],
              "published": true
            }
          ]
        },
        {
          "title": "System fields",
          "fields": [
            {
              "key": "app_source",
              "type": "string",
              "required": true,
              "system": true,
              "note": "Identifies the questionnaire that produced the record.",
              "published": true
            },
            {
              "key": "timestamp",
              "type": "datetime_iso8601",
              "required": true,
