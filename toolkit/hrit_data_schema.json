{
  "schema": "hrit-survey-schema",
  "version": "1.0.0",
  "title": "HRIT Toolkit: machine-readable schema of the four HRI questionnaires",
  "project": "HRIT, Human Robot Interaction Transparency (REINFORCING 3rd ORRI Incubator, GA 101094435)",
  "authors": [
    "Parity Platform P.C.",
    "University of Patras"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/Parity-Platform/hri_survey",
  "conventions": {
    "likert_1_5": "Integer 1 to 5. 1 is the first label in 'scale', 5 the last. Empty if not answered or not shown.",
    "multi_choice": "Stored as a comma separated string by google_sheets_script.",
    "shown_if": "Condition under which a field is displayed; otherwise the value is empty.",
    "published": "false means the field is removed or coarsened before publication (see 08_data_and_anonymisation.md)."
  },
  "surveys": [
    {
      "id": "manual_worker",
      "folder": "Manual Worker HRI Survey",
      "title": "HRI Manual Worker Interaction Survey",
      "app_source": "hri_manual_worker_survey",
      "audience": "Production line workers who work, or may soon work, alongside collaborative robots",
      "sections": [
        {
          "title": "1. General Information",
          "fields": [
            {
              "key": "department",
              "question": "Department:",
              "type": "single_choice",
              "required": true,
              "options": [
                "Production / Assembly",
                "Logistics / Warehousing",
                "Quality Control",
                "Maintenance / Engineering",
                "Management / Administration",
                "Other"
              ],
              "published": true
            },
            {
              "key": "email",
              "question": "Email Address (Optional)",
              "type": "email",
              "required": false,
              "personal_data": true,
              "published": false,
              "note": "Optional contact field. Removed before any publication or analysis export."
            },
            {
              "key": "country",
              "question": "Country:",
              "type": "single_choice",
              "required": true,
              "options": "ISO country list plus Other",
              "published": true
            },
            {
              "key": "years_experience",
              "question": "Years of work experience",
              "type": "single_choice",
              "required": true,
              "options": [
                "0-5 years",
                "6-10 years",
                "11-15 years",
                "15+ years"
              ],
              "published": true
            },
            {
              "key": "interaction_frequency",
              "question": "How often do you interact with robots in your work environment?",
              "type": "single_choice",
              "required": true,
              "options": [
                "Daily",
                "Weekly",
                "Rarely",
                "Never"
              ],
              "published": true
            }
          ]
        },
        {
          "title": "2. Safety & Perceptions",
          "fields": [
            {
              "key": "risk_felt",
              "question": "Have you ever felt at risk due to robotic behaviour?",
              "type": "single_choice",
              "required": true,
              "options": [
                "Yes",
                "No"
              ],
              "published": true
            },
            {
              "key": "risk_severity",
              "question": "Please rate the severity of the perceived risk:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Low",
                "2": "Low",
                "3": "Moderate",
                "4": "High",
                "5": "Very High"
              },
              "shown_if": "risk_felt == 'Yes'",
              "published": true
            },
            {
              "key": "perception_safety",
              "question": "I feel safe when working in close proximity to a robot.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "perception_predictability",
              "question": "I understand how the robot behaves and can predict what it will do next.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "perception_trust",
              "question": "I trust the robot to perform its task reliably without making mistakes.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            }
          ]
        },
        {
          "title": "3. Workload & Stress",
          "fields": [
            {
              "key": "productivity_impact",
              "question": "Working with robots has increased my overall productivity.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "stress_unexpected",
              "question": "I feel stressed or anxious when the robot performs unexpected actions.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "mental_load",
              "question": "I find it mentally challenging to cooperate and coordinate with the robot.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "physical_strain",
              "question": "The interaction with the robot increases my physical strain or fatigue.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            }
          ]
        },
        {
          "title": "4. Training & Confidence",
          "fields": [
            {
              "key": "training_received",
              "question": "I have received training before using the robot.",
              "type": "single_choice",
              "required": true,
              "options": [
                "Yes",
                "No"
              ],
              "published": true
            },
            {
              "key": "training_quality",
              "question": "Rate your training quality overall:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Poor",
                "2": "Fair",
                "3": "Average",
                "4": "Good",
                "5": "Excellent"
              },
              "shown_if": "training_received == 'Yes'",
              "published": true
            },
            {
              "key": "training_relevance",
              "question": "The training I received prepared me well for real-world tasks involving the robot.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "shown_if": "training_received == 'Yes'",
              "published": true
            },
            {
              "key": "confidence_level",
              "question": "I feel confident operating or interacting with the robot.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "confidence_autonomy",
              "question": "I feel confident enough to operate the robot without needing constant supervision or assistance.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            }
          ]
        },
        {
          "title": "System fields",
          "fields": [
            {
              "key": "app_source",
              "type": "string",
              "required": true,
              "system": true,
              "note": "Identifies the questionnaire that produced the record.",
              "published": true
            },
            {
              "key": "timestamp",
              "type": "datetime_iso8601",
              "required": true,
              "system": true,
              "published": false,
              "note": "Submission time. Coarsened to year and month in published exports."
            }
          ]
        }
      ]
    },
    {
      "id": "operator",
      "folder": "Operator HRI Interaction Survey",
      "title": "HRI Operator/Engineer Interaction Survey",
      "app_source": "hri_operator_survey",
      "audience": "Technical operators and engineers who interact directly with the robot",
      "sections": [
        {
          "title": "1. General Information",
          "fields": [
            {
              "key": "department",
              "question": "Department:",
              "type": "single_choice",
              "required": true,
              "options": [
                "Production / Assembly",
                "Logistics / Warehousing",
                "Quality Control",
                "Maintenance / Engineering",
                "Management / Administration",
                "Other"
              ],
              "published": true
            },
            {
              "key": "email",
              "question": "Email Address (Optional)",
              "type": "email",
              "required": false,
              "personal_data": true,
              "published": false,
              "note": "Optional contact field. Removed before any publication or analysis export."
            },
            {
              "key": "country",
              "question": "Country:",
              "type": "single_choice",
              "required": true,
              "options": "ISO country list plus Other",
              "published": true
            },
            {
              "key": "years_experience",
              "question": "Years of work experience",
              "type": "single_choice",
              "required": true,
              "options": [
                "0 - 5 years",
                "6-10 years",
                "11-15 years",
                "15+ years",
                "More"
              ],
              "published": true
            }
          ]
        },
        {
          "title": "2. Usability & Interface",
          "fields": [
            {
              "key": "training_received",
              "question": "I have received training before using the robot's operating tool.",
              "type": "single_choice",
              "required": true,
              "options": [
                "Yes",
                "No"
              ],
              "published": true
            },
            {
              "key": "training_quality",
              "question": "If Yes, rate your training quality overall:",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Poor",
                "2": "Fair",
                "3": "Average",
                "4": "Good",
                "5": "Excellent"
              },
              "shown_if": "training_received == 'Yes'",
              "published": true
            },
            {
              "key": "interface_intuitive",
              "question": "The robot's interface (e.g., GUI, controller hardware) is intuitive and easy to use for all required operational tasks.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "interface_safety_confidence",
              "question": "In any given time, how confident are you about the robot's interface ability to ensure safety if needed?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Not at all Confident",
                "2": "Slightly Confident",
                "3": "Moderately Confident",
                "4": "Confident",
                "5": "Very Confident"
              },
              "published": true
            }
          ]
        },
        {
          "title": "3. Cognitive Load & Complexity",
          "fields": [
            {
              "key": "robot_complexity",
              "question": "How complex is it to operate the robot?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Complex",
                "2": "Complex",
                "3": "Neutral",
                "4": "Easy",
                "5": "Very Easy"
              },
              "published": true
            },
            {
              "key": "assistance_frequency",
              "question": "How often do you need documentation or assistance?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Rarely",
                "2": "Occasionally",
                "3": "Sometimes",
                "4": "Often",
                "5": "Very Often"
              },
              "published": true
            },
            {
              "key": "mental_effort_monitoring",
              "question": "How much mental effort is required to monitor the robot during shared tasks?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Low Effort",
                "2": "Low Effort",
                "3": "Moderate Effort",
                "4": "High Effort",
                "5": "Very High Effort"
              },
              "published": true
            },
            {
              "key": "information_overload",
              "question": "How often does the system used to operate the robot overload you with information?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Rarely",
                "2": "Occasionally",
                "3": "Sometimes",
                "4": "Often",
                "5": "Very Often"
              },
              "published": true
            }
          ]
        },
        {
          "title": "4. Failures & Recovery",
          "fields": [
            {
              "key": "robot_failure_frequency",
              "question": "How often do robots fail or require human intervention?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Rarely",
                "2": "Occasionally",
                "3": "Sometimes",
                "4": "Often",
                "5": "Very Often"
              },
              "published": true
            },
            {
              "key": "troubleshooting_ease",
              "question": "How easy is it to troubleshoot potential failures of the robot or the robot's interface?",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Very Hard",
                "2": "Hard",
                "3": "Neutral",
                "4": "Easy",
                "5": "Very Easy"
              },
              "published": true
            },
            {
              "key": "hmi_recovery_tools",
              "question": "The Human-Machine-Interface (HMI) provides the necessary tools and access to safely and efficiently recover from a failure.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            }
          ]
        },
        {
          "title": "5. Psychological Impact & Trust",
          "fields": [
            {
              "key": "sense_of_control",
              "question": "I feel in control of the robot's actions, rather than the robot controlling my workflow.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "job_security_confidence",
              "question": "I am confident that the introduction of more robots like this will not negatively impact my long-term job security.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "error_responsibility",
              "question": "When the system makes a mistake, I feel like I am the one held responsible for the error.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            },
            {
              "key": "skill_enhancement",
              "question": "I feel that operating this robot enhances my professional skills rather than making my job feel repetitive or 'robotic'.",
              "type": "likert_1_5",
              "required": true,
              "scale": {
                "1": "Strongly Disagree",
                "2": "Disagree",
                "3": "Neutral",
                "4": "Agree",
                "5": "Strongly Agree"
              },
              "published": true
            }
          ]
        },
        {
          "title": "System fields",
          "fields": [
            {
              "key": "app_source",
              "type": "string",
              "required": true,
              "system": true,
              "note": "Identifies the questionnaire that produced the record.",
              "published": true
            },
            {
              "key": "timestamp",
              "type": "datetime_iso8601",
              "required": true,
              "system": true,
              "published": false,
              "note": "Submission time. Coarsened to year and month in published exports."
            }
          ]
        }
      ]
    },
    {
      "id": "supervisor",
      "folder": "Supervisor HRI Interaction Survey",
      "title": "HRI Manager/Supervisor Survey",
      "app_source": "hri_manager_survey",
      "audience": "Line supervisors, team leaders and managers of teams working with robots",
      "sections": [
        {
          "title": "1. General Information",
