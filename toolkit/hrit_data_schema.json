              "required": true,
              "options": "ISO country list plus Other",
              "published": true
            },
            {
              "key": "operation_size",
              "question": "Size of operation:",
              "type": "single_choice",
              "required": true,
              "options": [
                "1-50 employees",
                "51-200 employees",
                "201-500 employees",
                "500+ employees"
              ],
              "published": true
            },
            {
              "key": "employees_interacting",
              "question": "Number of employees interacting with robots:",
              "type": "single_choice",
              "required": true,
              "options": [
                "1-30",
                "31-60",
                "61-100",
                "More"
              ],
              "published": true
            }
          ]
        },
        {
          "title": "2. Reasons for Robot Adoption",
          "fields": [
            {
              "key": "adoption_reasons",
              "question": "What are the main reasons for adopting robots in the workforce?",
              "type": "single_choice",
              "required": true,
              "options": [
                "Reduce physical strain",
                "Reduce labour costs",
                "Increase quality",
                "Improve safety",
                "Speed up production",
                "Other"
              ],
