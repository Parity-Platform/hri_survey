    {
      "id": "future_impact",
      "folder": "Future Impact HRI Supervisor",
      "title": "Future impact of HRI integration",
      "app_source": "hri_future_impact_survey",
      "audience": "Supervisors and managers assessing medium and long term effects of HRI",
      "sections": [
        {
          "title": "1. General Information",
          "fields": [
            {
              "key": "department",
              "question": "Department:",
              "type": "single_choice",
              "required": true,
              "options": [
                "Production / Assembly",
                "Logistics / Warehousing",
                "Quality Control",
                "Maintenance / Engineering",
                "Management / Administration",
                "Other"
              ],
              "published": true
